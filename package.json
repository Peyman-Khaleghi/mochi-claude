{
  "name": "mochi-claude",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Mochi sits at the top of your screen and tells you which Claude Code window needs you.",
  "main": "dist/main.js",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "start": "node build.mjs && node scripts/start.mjs",
    "package": "node build.mjs && node scripts/package.mjs",
    "icon": "node scripts/make-icon.mjs",
    "fake": "node scripts/fake-hook.mjs"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "^24.0.0",
    "electron": "^44.5.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
